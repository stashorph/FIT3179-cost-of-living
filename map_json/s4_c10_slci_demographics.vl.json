    "transform": [
        {
            "calculate": "toDate(datum.Date)",
            "as": "ParsedDate"
        },
        {
            "calculate": "clamp(datum.LCI, 0, 5)",
            "as": "Band1"
        },
        {
            "calculate": "datum.LCI > 5 ? datum.LCI - 5 : 0",
            "as": "Band2"
        }
    ],
    "facet": {
        "row": {
            "field": "Household",
            "type": "nominal",
            "title": null,
            "sort": [
                "Employee Households",
                "Other Govt Transfer Recipients",
                "Age Pensioner Households",
                "Self-Funded Retirees"
            ],
            "header": {
                "labelAngle": 0,
                "labelAlign": "left",
                "labelFontWeight": 700,
                "labelFontSize": 11.5,
                "labelColor": "#18202C"
            }
        }
    },
    "spec": {
        "width": "container",
        "height": 68,
        "layer": [
            {
                "mark": {
                    "type": "area",
                    "interpolate": "monotone",
                    "opacity": 0.65
                },
                "encoding": {
                    "x": {
                        "field": "ParsedDate",
                        "type": "temporal",
                        "title": null,
                        "axis": {
                            "format": "%Y",
                            "tickCount": 7
                        }
                    },
                    "y": {
                        "field": "Band1",
                        "type": "quantitative",
                        "scale": {
                            "domain": [
                                0,
                                5
                            ]
                        },
                        "title": "0–5%",
                        "axis": {
                            "tickCount": 2,
                            "labelFontSize": 9.5
                        }
                    },
                    "color": {
                        "datum": "Band 1: Moderate (0% to 5%)",
                        "type": "nominal",
                        "scale": {
                            "domain": [
                                "Band 1: Moderate (0% to 5%)",
                                "Band 2: Severe Excess (5% to 10%+)"
                            ],
                            "range": [
                                "#F59E0B",
                                "#B5462F"
                            ]
                        },
                        "legend": {
                            "title": "Horizon Fold Bands",
                            "orient": "top",
                            "titleFontWeight": 600
                        }
                    }
                }
            },
            {
                "mark": {
                    "type": "area",
                    "interpolate": "monotone",
                    "opacity": 0.9
                },
                "encoding": {
                    "x": {
                        "field": "ParsedDate",
                        "type": "temporal"
                    },
                    "y": {
                        "field": "Band2",
                        "type": "quantitative"
                    },
                    "color": {
                        "datum": "Band 2: Severe Excess (5% to 10%+)",
                        "type": "nominal"
                    },
                    "tooltip": [
                        {
                            "field": "Household",
                            "type": "nominal",
                            "title": "Household Group"
                        },
                        {
                            "field": "ParsedDate",
                            "type": "temporal",
                            "title": "Quarter",
                            "format": "%b %Y"
                        },
                        {
                            "field": "LCI",
                            "type": "quantitative",
                            "title": "Annual Living Cost Growth (%)",
                            "format": "+.1f"
                        }
                    ]
                }
            }
        ]
    }
